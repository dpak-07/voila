{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PipelineStatusCollection",
  "type": "object",
  "description": "MongoDB collection tracking real-time status and history of pipeline execution runs.",
  "properties": {
    "_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string",
      "description": "Unique UUID of the pipeline execution run."
    },
    "step": {
      "type": "string",
      "enum": ["INIT", "LOAD_DATA", "CLEAN_TEXT", "CLUSTER_TOPICS", "SPIKE_DETECTION", "KPI_CALCULATION", "SAVE_DB", "RUN"],
      "description": "Current pipeline execution phase."
    },
    "status": {
      "type": "string",
      "enum": ["STARTED", "SUCCESS", "COMPLETED", "FAILED"],
      "description": "State of the current pipeline step."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "error": {
      "type": "string",
      "description": "Exception trace or error message if the status is FAILED."
    },
    "history": {
      "type": "array",
      "description": "Chronological audit trail of all phases executed in this run.",
      "items": {
        "type": "object",
        "properties": {
          "run_id": { "type": "string" },
          "step": { "type": "string" },
          "status": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" },
          "error": { "type": "string" }
        }
      }
    }
  },
  "required": ["run_id", "step", "status", "timestamp"]
}
