# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=voila
MONGO_COLLECTION=conversations

# Vector DB
VECTOR_DB_TYPE=mongo
VECTOR_DB_URL=
VECTOR_DB_API_KEY=

# AWS S3
AWS_S3_BUCKET=your-bucket-name
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_BEARER_TOKEN_BEDROCK=

# Agentic Service / Bedrock
AGENTIC_BEDROCK_MODEL_ID=google.gemma-3-27b-it
AGENTIC_USE_BEDROCK_MOCK=true
AGENTIC_MIN_NLP_CONFIDENCE=0.6
AGENTIC_MIN_SAMPLE_SIZE=1

# Snowflake
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=

# App
AUTH_SECRET=change-me
DEBUG=true
