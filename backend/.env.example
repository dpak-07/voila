# ====================================================================
# VOILA VOICE-OF-CUSTOMER PLATFORM - SECURE ENVIRONMENT CONFIGURATION
# ====================================================================
# Copy this file to .env and replace placeholders with your credentials.
# NEVER commit .env to version control.

# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=voila
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
DATABASE_URL=postgresql://postgres:your_secure_postgres_password@localhost:5432/voila

# Vector Database (Qdrant)
VECTOR_DB_TYPE=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# AWS S3 Cloud Storage
AWS_S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_BEARER_TOKEN_BEDROCK=

# Agentic Service / LLM Reasoning
AGENTIC_BEDROCK_MODEL_ID=google.gemma-3-27b-it
AGENTIC_USE_BEDROCK_MOCK=true
AGENTIC_MIN_NLP_CONFIDENCE=0.6
AGENTIC_MIN_SAMPLE_SIZE=1

# Snowflake Data Warehouse (Optional)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
PERSIST_PROCESSED_TO_SNOWFLAKE=false
PERSIST_KPI_TO_SNOWFLAKE=false

# Security & Authentication Secret (Generate with: openssl rand -hex 32)
AUTH_SECRET=generate_your_secure_random_secret_key_here
DEBUG=false
